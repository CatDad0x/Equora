# Which deployment to use: 31337 (local anvil) or 84532 (Base Sepolia)
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Optional: Privy app id enables email login with embedded wallets
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: keeper health endpoint shown on the admin page
NEXT_PUBLIC_KEEPER_URL=http://127.0.0.1:8787
# Server-only: funded testnet key used by /api/onboard to send gas + faucet tokens to new users
RELAYER_PRIVATE_KEY=
