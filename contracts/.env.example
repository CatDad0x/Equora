# Deployer (becomes admin of every contract). Use a fresh testnet-only key.
PRIVATE_KEY=
# Address of the keeper bot wallet (separate testnet-only key recommended)
KEEPER_ADDRESS=
# Base Sepolia RPC (public: https://sepolia.base.org, or Alchemy/QuickNode for reliability)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# For contract verification on Basescan
BASESCAN_API_KEY=
# Optional: use real Pyth instead of keeper-simulated prices (needs a Pyth API key in the keeper)
# PYTH_ADDRESS=0xA2aa501b19aff244D90cc15a4Cf739D2725B5729
# FEED_SPY=0x...  FEED_AAPL=0x...  FEED_MSFT=0x...  FEED_NVDA=0x...  FEED_AMZN=0x...  FEED_GOOGL=0x...
# FEED_AUD=0x...  FEED_EUR=0x...  FEED_INR=0x...   (USD/INR feed; inverted automatically)
